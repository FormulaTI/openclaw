{
  "gateway": {
    "mode": "local"
  },
  "channels": {
    "slack": {
      "enabled": true,
      "mode": "socket",
      "appToken": "${SLACK_APP_TOKEN}",
      "botToken": "${SLACK_BOT_TOKEN}",
      "dmPolicy": "open",
      "defaultChannelPolicy": "mention"
    }
  },
  "agents": {
    "dir": ".agents/agents"
  }
}
